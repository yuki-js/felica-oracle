213714585485750436656883172, 6316844841266187823876685841782356483855817998289908377388503382590424184532, 11578600216653045838620007964651251362054970647042320860355662484805383458147, 17024906103834321170128014378172345520905215513123025575692615494927378792675, 10030890106874404702167705141747180900495116818908239590666656676341561665800, 12065862294248176242346985415578860090652358139779566409324259491443913641057, 21574400970564588731686120289565525125139992460269328982381931449994994530707, 3717912536494888263015214893011366622942621280497927054896302936327353985511, 6173632933092076627363311732250594975066497252996647547404528582663351196835, 12426630215606648784402260442771961850873332942634734062769802957716969327226, 2577380780541718127404056248348978516073591721471280584986179610511825024537, 12100851842277567201134479565432089934040889390206125403320093785543994841211, 17450106449181325326309642675816384954177312754501475898307143881444187663968];

    // Select this box's poly (compile-time branch on `idx`).
    var poly[64];
    for (var j = 0; j < 64; j++) {
        if (idx == 0) { poly[j] = S_POLY_0[j]; }
        else if (idx == 1) { poly[j] = S_POLY_1[j]; }
        else if (idx == 2) { poly[j] = S_POLY_2[j]; }
        else if (idx == 3) { poly[j] = S_POLY_3[j]; }
        else if (idx == 4) { poly[j] = S_POLY_4[j]; }
        else if (idx == 5) { poly[j] = S_POLY_5[j]; }
        else if (idx == 6) { poly[j] = S_POLY_6[j]; }
        else { poly[j] = S_POLY_7[j]; }
    }

    signal idxv;
    idxv <== in[0]*32 + in[1]*16 + in[2]*8 + in[3]*4 + in[4]*2 + in[5];
    // Horner from the top with a forward loop (loop counters must not wrap):
    // acc[63] = c63; acc[62-i] = acc[63-i]*in + c[62-i].
    signal acc[64];
    acc[63] <== poly[63];
    for (var i = 0; i < 63; i++) {
        acc[62-i] <== acc[63-i] * idxv + poly[62-i];
    }
    // Witness hints (as in `Num2Bits`): output bits of the poly value, pinned
    // to boolean and to the value below.
    for (var k = 0; k < 4; k++) {
        out[k] <-- (acc[0] >> (3-k)) & 1;
        out[k] * (out[k] - 1) === 0;
    }
    out[0]*8 + out[1]*4 + out[2]*2 + out[3] === acc[0];
}

// DesRoundKeys: 16x48 round keys as wiring over the key's LE bits
// (mirrors `round_key_vars`: PC1 over DES-ordered key, split C/D, left
// rotations per SHIFTS, PC2 per round).
template DesRoundKeys() {
    signal input key[64];
    signal output rk[16][48];

    var PC1_TBL[56] = [56, 48, 40, 32, 24, 16, 8, 0, 57, 49, 41, 33, 25, 17, 9, 1, 58, 50, 42, 34, 26, 18, 10, 2, 59, 51, 43, 35, 62, 54, 46, 38, 30, 22, 14, 6, 61, 53, 45, 37, 29, 21, 13, 5, 60, 52, 44, 36, 28, 20, 12, 4, 27, 19, 11, 3];
    var PC2_TBL[48] = [13, 16, 10, 23, 0, 4, 2, 27, 14, 5, 20, 9, 22, 18, 11, 3, 25, 7, 15, 6, 26, 19, 12, 1, 40, 51, 30, 36, 46, 54, 29, 39, 50, 44, 32, 47, 43, 48, 38, 55, 33, 52, 45, 41, 49, 35, 28, 31];
    var SHIFT_TBL[16] = [1, 1, 2, 2, 2, 2, 2, 2, 1, 2, 2, 2, 2, 2, 2, 1];

    signal keyDes[64];
    for (var i = 0; i < 8; i++) {
        for (var j = 0; j < 8; j++) {
            keyDes[i*8+j] <== key[i*8+(7-j)];
        }
    }
    signal pc1[56];
    for (var i = 0; i < 56; i++) {
        pc1[i] <== keyDes[PC1_TBL[i]];
    }
    // Cumulative left shift S: C/D position p holds original bit (p+S)%28.
    var shift = 0;
    for (var round = 0; round < 16; round++) {
        shift += SHIFT_TBL[round];
        for (var i = 0; i < 48; i++) {
            var src = PC2_TBL[i];
            if (src < 28) {
                rk[round][i] <== pc1[(src + shift) % 28];
            } else {
                rk[round][i] <== pc1[28 + ((src - 28 + shift) % 28)];
            }
        }
    }
}

// DesBlock(enc): single DES block (mirrors `des_gadget`). `data` is 64
// DES-ordered bits, `key` is 64 LE key bits. No final swap: pre-output is
// R16 || L16, then FP = IP^{-1}.
template DesBlock(enc) {
    signal input data[64];
    signal input key[64];
    signal output out[64];

    var IP_TBL[64] = [57, 49, 41, 33, 25, 17, 9, 1, 59, 51, 43, 35, 27, 19, 11, 3, 61, 53, 45, 37, 29, 21, 13, 5, 63, 55, 47, 39, 31, 23, 15, 7, 56, 48, 40, 32, 24, 16, 8, 0, 58, 50, 42, 34, 26, 18, 10, 2, 60, 52, 44, 36, 28, 20, 12, 4, 62, 54, 46, 38, 30, 22, 14, 6];
    var E_TBL[48] = [31, 0, 1, 2, 3, 4, 3, 4, 5, 6, 7, 8, 7, 8, 9, 10, 11, 12, 11, 12, 13, 14, 15, 16, 15, 16, 17, 18, 19, 20, 19, 20, 21, 22, 23, 24, 23, 24, 25, 26, 27, 28, 27, 28, 29, 30, 31, 0];
    var P_TBL[32] = [15, 6, 19, 20, 28, 11, 27, 16, 0, 14, 22, 25, 4, 17, 30, 9, 1, 7, 23, 13, 31, 26, 2, 8, 18, 12, 29, 5, 21, 10, 3, 24];

    component rks = DesRoundKeys();
    for (var i = 0; i < 64; i++) {
        rks.key[i] <== key[i];
    }

    signal ip[64];
    for (var i = 0; i < 64; i++) {
        ip[i] <== data[IP_TBL[i]];
    }
    signal L[17][32];
    signal R[17][32];
    signal X[16][48];
    signal SOUT[16][32];
    signal F[16][32];
    for (var i = 0; i < 32; i++) {
        L[0][i] <== ip[i];
        R[0][i] <== ip[32+i];
    }
    component sb[16][8];
    for (var round = 0; round < 16; round++) {
        // Round-key order selected at elaboration time (mirrors the Rust
        // `if !encrypt { rkeys.reverse(); }`).
        var r = enc == 1 ? round : 15 - round;
        // Expansion (wiring) + XOR with round key: x = e + k - 2*e*k.
        for (var i = 0; i < 48; i++) {
            X[round][i] <== R[round][E_TBL[i]] + rks.rk[r][i] - 2*R[round][E_TBL[i]]*rks.rk[r][i];
        }
        // S-boxes.
        for (var b = 0; b < 8; b++) {
            sb[round][b] = SBox(b);
            for (var k = 0; k < 6; k++) {
                sb[round][b].in[k] <== X[round][b*6+k];
            }
        }
        for (var b = 0; b < 8; b++) {
            for (var k = 0; k < 4; k++) {
                SOUT[round][b*4+k] <== sb[round][b].out[k];
            }
        }
        // P permutation (wiring) + L xor F.
        for (var i = 0; i < 32; i++) {
            F[round][i] <== SOUT[round][P_TBL[i]];
        }
        for (var i = 0; i < 32; i++) {
            L[round+1][i] <== R[round][i];
            R[round+1][i] <== L[round][i] + F[round][i] - 2*L[round][i]*F[round][i];
        }
    }
    // No final swap: pre-output R16 || L16, then FP = IP^{-1}
    // (out[IP[i]] = pre[i], mirroring the Rust `fp_table` wiring).
    signal pre[64];
    for (var i = 0; i < 32; i++) {
        pre[i] <== R[16][i];
        pre[32+i] <== L[16][i];
    }
    for (var i = 0; i < 64; i++) {
        out[IP_TBL[i]] <== pre[i];
    }
}

// TdesEde: two-key EDE 3DES, E(k1)->D(k2)->E(k1)
// (mirrors `tdes_encrypt_gadget`).
template TdesEde() {
    signal input data[64];
    signal input k1[64];
    signal input k2[64];
    signal output out[64];

    component e1 = DesBlock(1);
    component d2 = DesBlock(0);
    component e3 = DesBlock(1);
    // All inputs of a component must be assigned before any of its outputs
    // is read, hence one loop per wiring stage.
    for (var i = 0; i < 64; i++) {
        e1.data[i] <== data[i];
        e1.key[i] <== k1[i];
        d2.key[i] <== k2[i];
        e3.key[i] <== k1[i];
    }
    for (var i = 0; i < 64; i++) {
        d2.data[i] <== e1.out[i];
    }
    for (var i = 0; i < 64; i++) {
        e3.data[i] <== d2.out[i];
    }
    for (var i = 0; i < 64; i++) {
        out[i] <== e3.out[i];
    }
}
