pragma circom 2.1.9;

// DES / 3DES-EDE gadgets for the FeliCa DES oracle (spec docs/spec.md §4.1, §7).
//
// Human-readable companion to `circom-prover/src/circuit.rs`: every template
// here names the Rust item mirroring it (`SBox` → `sbox_gadget`, `DesBlock`
// → `des_gadget`, `TdesEde` → `tdes_encrypt_gadget`, `DesRoundKeys` → the
// `round_key_vars` wiring). The Rust side is the executable mirror exercised
// by `cargo test` (fast arkworks prover, no Node needed); this file compiles
// with `circom` 2.x for the snarkjs / Solidity / Move toolchains
// (`scripts/compile.sh`).
//
// Bit conventions (identical to `src/des.rs`, `src/circuit.rs`):
// - Bytes are field elements range-checked to 8 bits (`Num2Bits(8)`).
// - LE bits: bit j of byte i at index 8*i+j (LSB-first within each byte).
// - DES-ordered bits: DES bit k = LE[8*(k/8)+7-(k%8)] (MSB-first within each
//   byte; FIPS 46-3 bit 1 = MSB of byte 0). All permutation tables below
//   index DES-ordered bits and are 0-indexed copies of `src/des.rs`.
// - S-box input: 6 bits b0-first (MSB); binary index b0*32+…+b5. Output:
//   4 bits o0-first (MSB), value o0*8+…+o3.
// - The `enc` template parameter (1 = encrypt, 0 = decrypt) selects the round
//   key order at elaboration time — it is never a signal, mirroring the Rust
//   `encrypt: bool` argument.

// Num2Bits(n): decompose into n LSB-first bits (out[0] = LSB).
template Num2Bits(n) {
    signal input in;
    signal output out[n];
    var acc = 0;
    var pow = 1;
    for (var i = 0; i < n; i++) {
        out[i] <-- (in >> i) & 1;
        out[i] * (out[i] - 1) === 0;
        acc += out[i] * pow;
        pow *= 2;
    }
    acc === in;
}

// Bits2Num(n): LSB-first bits -> field element (linear, no constraint).
template Bits2Num(n) {
    signal input in[n];
    signal output out;
    var acc = 0;
    var pow = 1;
    for (var i = 0; i < n; i++) {
        acc += in[i] * pow;
        pow *= 2;
    }
    out <== acc;
}

// BytesToLeBits(n): n bytes -> n*8 LSB-first bits (range-checks each byte).
template BytesToLeBits(n) {
    signal input bytes[n];
    signal output bits[n*8];
    component n2b[n];
    for (var i = 0; i < n; i++) {
        n2b[i] = Num2Bits(8);
        n2b[i].in <== bytes[i];
        for (var j = 0; j < 8; j++) {
            bits[i*8+j] <== n2b[i].out[j];
        }
    }
}

// LeToDes(n): LE bits -> DES-ordered bits, n bytes (wiring).
template LeToDes(n) {
    signal input le[n*8];
    signal output des[n*8];
    for (var i = 0; i < n; i++) {
        for (var j = 0; j < 8; j++) {
            des[i*8+j] <== le[i*8+(7-j)];
        }
    }
}

// DesToLe(n): DES-ordered bits -> LE bits, n bytes (wiring).
template DesToLe(n) {
    signal input des[n*8];
    signal output le[n*8];
    for (var i = 0; i < n; i++) {
        for (var j = 0; j < 8; j++) {
            le[i*8+j] <== des[i*8+(7-j)];
        }
    }
}

// SBox(idx): 6 MSB-first bits -> 4 MSB-first bits (mirrors `sbox_gadget`).
//
// `S_TBL_*` are the FIPS 46-3 S-boxes in (row, col) layout
// (`S_TBL_b[row*16+col]`, row = b0*2+b5, col = b1*8+b2*4+b3*2+b4) — the
// auditable source of truth, byte-for-byte equal to `src/des.rs::SBOX`.
// `S_POLY_*` are the degree-63 interpolation polynomials over the BN254
// scalar field evaluated at the binary index (b0*32+…+b5), i.e. the
// `sbox_mapped` ordering of `src/des.rs`. The constraint is
// `o0*8+o1*4+o2*2+o3 == P(in)`. Regenerate the poly blocks with
// `cargo run --example gen_sbox_poly`; any drift between tables and polys
// (or between here and `src/des.rs`) fails `tests/circom_consistency.rs`.
